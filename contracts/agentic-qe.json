  },
  "tools": {
    "test_generate_enhanced": {
      "input_fields": [
        "sourceCode",
        "filePath",
        "language",
        "testType",
        "framework",
        "coverageGoal",
        "behaviorExamples",
        "aiEnhancement",
        "detectAntiPatterns",
        "saveResults"
      ],
      "required_input_fields": [],
      "result_data_schema": "test_generation_data",
      "meaning": "Candidate source; actual test execution remains required."
    },
    "coverage_analyze_sublinear": {
      "input_fields": [
        "target",
        "detectGaps",
        "saveResults"
      ],
      "required_input_fields": [
        "target"
      ],
      "result_data_schema": "coverage_data",
      "meaning": "Measured, estimated and unmeasured are distinct; native report/source evidence required."
    },
    "quality_assess": {
      "input_fields": [
        "runGate",
        "metrics",
        "target",
        "sourceFiles",
        "saveResults"
      ],
      "required_input_fields": [],
      "result_data_schema": "quality_data",
      "meaning": "Analysis is not gate execution; insufficient evidence cannot pass."
    }
  },
  "output_schemas": {
    "test_generation_data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "status",
        "tests",
        "llmEnhanced"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testCode": {
                "type": "string"
              },
              "generationMode": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "llmEnhanced": {
          "type": "boolean"
        },
        "generationMode": {
          "type": "string"
        },
        "coverageEstimate": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "coverage_data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "status",
        "measured",
        "estimated",
        "coverageMethod",
        "lineCoverage",
        "branchCoverage",
        "functionCoverage",
        "branchDataCollected",
        "functionDataCollected"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "measured": {
          "type": "boolean"
        },
        "estimated": {
          "type": "boolean"
        },
        "coverageMethod": {
          "type": "string"
        },
        "lineCoverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "branchCoverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "functionCoverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "branchDataCollected": {
          "type": "boolean"
        },
        "functionDataCollected": {
          "type": "boolean"
        },
        "unmeasured": {
          "type": "boolean"
        },
        "runStatus": {
          "enum": [
            "passed",
            "failed"
          ]
        }
      },
      "additionalProperties": true
    },
    "quality_data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "passed",
        "gateEvaluated"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "gateEvaluated": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "evidenceStatus": {
          "type": "string"
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "measuredFailures": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "raw_response_policy": {
    "retain_complete_mcp_envelope": true,
    "retain_handler_envelope": true,
    "reject_for_pass": [
      "isError true",
      "success false",
      "non-JSON or truncated text",
      "unknown result shape",
      "missing required capability",
      "insufficient-evidence",
      "stale or mismatched source/report"
    ],
    "missing_fields": "Unknown/incomplete; never fill with successful defaults. A loop-steering text prefix or compacted response needs retained original evidence, not heuristic green parsing."
  },
  "evidence_fields": [
    "tool_server_identity",
    "tool_name",
    "tool_schema_digest",
    "aqe_version",
    "aqe_package_integrity",
    "protocol_version",
    "request",
    "raw_response_path",
    "raw_response_sha256",
    "source_revision",
    "source_dirty_inputs",
    "started_at",
    "completed_at",
    "native_test_command",
    "native_test_output_sha256"
  ],
  "memory": {
    "supported_env": {
      "AQE_MEMORY_BACKEND": "memory",
      "AQE_WORKERS_ENABLED": "false"
    },
    "memory_mode_disables_embedding_attempts": false,
    "embedding_endpoint": "OpenAI-style POST /v1/embeddings; bearer token via AQE_EMBEDDER_TOKEN",
    "default_model": "Xenova/all-MiniLM-L6-v2",
    "dimensions": 384,
    "durable_owner": "Host-approved memory API; no raw SQL or automatic second service."
  },
